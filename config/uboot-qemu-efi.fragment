# Additions on top of upstream U-Boot v2026.10 qemu_arm64_defconfig.
# This machine is QEMU virt. It is not an Apple Silicon Mac.

CONFIG_BOOTDELAY=0
CONFIG_VIDEO=y
CONFIG_VIDEO_BOCHS=y
CONFIG_VIDEO_BOCHS_SIZE_X=1024
CONFIG_VIDEO_BOCHS_SIZE_Y=768
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="usb start"
CONFIG_EFI_LOADER=y
